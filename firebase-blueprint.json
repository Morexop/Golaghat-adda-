{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "User public nickname profile tied to an anonymous Firebase UID",
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9_ -]+$",
          "description": "User chosen display nickname"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of profile owner"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        }
      },
      "required": ["nickname", "authorUid", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Public comedy comment posted in Golaghat Public Adda",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase UID of comment creator"
        },
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "description": "Snapshot of author nickname at post time"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Comment message content"
        },
        "likeCount": {
          "type": "number",
          "description": "Total like counter"
        },
        "replyCount": {
          "type": "number",
          "description": "Total replies counter"
        },
        "status": {
          "type": "string",
          "enum": ["published", "hidden", "flagged"],
          "description": "Moderation status"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether this comment is currently pinned by moderator"
        },
        "pinnedReason": {
          "type": "string",
          "maxLength": 200,
          "description": "Reason comment was pinned"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["authorUid", "nickname", "text", "likeCount", "status", "createdAt"]
    },
    "Reply": {
      "title": "Reply",
      "description": "Nested reply under a parent comment",
      "type": "object",
      "properties": {
        "commentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Parent comment identifier"
        },
        "parentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Immediate parent comment or reply id (max depth 2)"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Author UID"
        },
        "nickname": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "description": "Author nickname snapshot"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Reply content text"
        },
        "likeCount": {
          "type": "number",
          "description": "Likes counter"
        },
        "status": {
          "type": "string",
          "enum": ["published", "hidden", "flagged"],
          "description": "Moderation visibility status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        }
      },
      "required": ["commentId", "authorUid", "nickname", "text", "likeCount", "status", "createdAt"]
    },
    "Like": {
      "title": "Like",
      "description": "Unique like record to guarantee one like per authenticated UID",
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "maxLength": 128,
          "description": "Target comment or reply document ID"
        },
        "targetType": {
          "type": "string",
          "enum": ["comment", "reply"],
          "description": "Type of item liked"
        },
        "userUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of person who liked"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when like was created"
        }
      },
      "required": ["targetId", "userUid", "createdAt"]
    },
    "PinSuggestion": {
      "title": "PinSuggestion",
      "description": "Community member suggestion to pin a favorite funny comment",
      "type": "object",
      "properties": {
        "targetCommentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Target comment ID"
        },
        "commentText": {
          "type": "string",
          "maxLength": 500,
          "description": "Snapshot of comment text"
        },
        "authorNickname": {
          "type": "string",
          "maxLength": 24,
          "description": "Author nickname"
        },
        "requesterUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of user who suggested pin"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300,
          "description": "Why this message should be pinned"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderator review status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp submitted"
        }
      },
      "required": ["targetCommentId", "commentText", "requesterUid", "reason", "status", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Protected report record submitted against abusive content",
      "type": "object",
      "properties": {
        "targetId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of comment or reply reported"
        },
        "targetType": {
          "type": "string",
          "enum": ["comment", "reply"],
          "description": "Type of reported entity"
        },
        "targetText": {
          "type": "string",
          "maxLength": 500,
          "description": "Snapshot of reported text"
        },
        "reporterUid": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of reporter"
        },
        "reason": {
          "type": "string",
          "maxLength": 100,
          "description": "Report category"
        },
        "details": {
          "type": "string",
          "maxLength": 500,
          "description": "Additional details provided"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "dismissed"],
          "description": "Moderation status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["targetId", "reporterUid", "reason", "status", "createdAt"]
    },
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Global configuration including current active pinned announcement",
      "type": "object",
      "properties": {
        "activePinnedCommentId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of currently pinned comment or empty string"
        },
        "pinnedText": {
          "type": "string",
          "maxLength": 500,
          "description": "Content of the pinned announcement"
        },
        "pinnedAuthor": {
          "type": "string",
          "maxLength": 50,
          "description": "Display name of pinned author"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp updated"
        }
      },
      "required": ["pinnedText", "pinnedAuthor", "updatedAt"]
    }
  },
  "firestore": {
    "/publicProfiles/{uid}": {
      "schema": "PublicProfile",
      "description": "Public profiles with nicknames"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Golaghat Public Adda main comments"
    },
    "/comments/{commentId}/replies/{replyId}": {
      "schema": "Reply",
      "description": "Nested replies for a comment"
    },
    "/comments/{commentId}/likes/{uid}": {
      "schema": "Like",
      "description": "Per-user likes for a comment"
    },
    "/pinSuggestions/{suggestionId}": {
      "schema": "PinSuggestion",
      "description": "Community suggestions to pin comments"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Protected reports for moderators"
    },
    "/siteSettings/{settingId}": {
      "schema": "SiteSetting",
      "description": "Global settings such as active pinned post"
    }
  }
}
